# PostgreSQL
# Replace credentials with your own local values.
DATABASE_URL=postgresql+psycopg://automatch_user:replace_me@127.0.0.1:5432/automatch

# AI provider: ollama or openai
AI_PROVIDER=ollama

# Local Ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_HOST=http://127.0.0.1:11434

# Optional cloud AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Development-only anomaly review API key.
# Leave unset for public deployment until proper auth is added.
AUTOMATCH_REVIEW_API_KEY=